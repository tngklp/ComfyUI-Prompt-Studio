# Test and runtime scratch. The standalone host shim defaults its temp directory to
# <cwd>/data/tmp and backend/media.py writes "derived_<uuid>/" beside each asset it
# processes, so running either suite from the repository root leaves empty
# directories behind. They are not tracked and are always safe to delete.
/data/
/tmp/
/derived_*/

# The Anima character catalogue is downloaded on first launch, not shipped. It is
# 9 MB of CSV and 4 MB of index, it changes independently of this repository, and
# every install would otherwise carry a copy that goes stale silently. Deleting this
# file makes the next launch fetch it again.
backend/data/anima_characters.cache.json
